<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CntlLevelConnection</AssemblyName>
    <RootNamespace>CntlLevelConnection</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <Company>Kazutaka Kurihara</Company>
    <Authors>Kazutaka Kurihara</Authors>
    <Product>LLMCon</Product>
    <Copyright>Copyright © Kazutaka Kurihara</Copyright>
  </PropertyGroup>

  <!-- WinForms は NotifyIcon（タスクトレイ）のためだけに使う。暗黙 using は WPF の型（Application/Point/
       KeyEventArgs など）と衝突するので外す。WinForms 型はコード側で完全修飾する。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 中核は Core にある。ここには Windows に固有なものだけを置く（ViGEm、Windows.Gaming.Input、
       winmm、NAudio、WPF、WinForms）。 -->
  <ItemGroup>
    <ProjectReference Include="..\CntlLevelConnection.Core\CntlLevelConnection.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
