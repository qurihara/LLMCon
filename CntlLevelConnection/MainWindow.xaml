<Window x:Class="CntlLevelConnection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controller Level Connection - Xbox360"
        Height="680" Width="860"
        Background="#1a1a2e"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Window.Resources>
        <!-- ベースボタンスタイル -->
        <Style x:Key="CtrlBtn" TargetType="Button">
            <Setter Property="Width"  Value="70"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="circle" Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小ボタン（LB/RB/LT/RT/Start/Back） -->
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource CtrlBtn}">
            <Setter Property="Width"  Value="54"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="rect" Fill="{TemplateBinding Background}"
                                       RadiusX="10" RadiusY="10"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="rect" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 十字キーボタン -->
        <Style x:Key="DpadBtn" TargetType="Button" BasedOn="{StaticResource CtrlBtn}">
            <Setter Property="Width"  Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background" Value="#444466"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="rect" Fill="{TemplateBinding Background}"
                                       RadiusX="4" RadiusY="4"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="rect" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🎮" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="HeaderText" Text="Xbox 360 Controller" FontSize="20" FontWeight="Bold"
                       Foreground="#00d4ff" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="  ● 未接続" FontSize="13"
                       Foreground="#ff6b6b" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- メインコントローラーレイアウト（ui="controller" のときだけ出す） -->
        <Grid x:Name="ControllerArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- 左エリア（Dpad + LT/LB） -->
                <ColumnDefinition Width="Auto"/> <!-- 中央（Start/Back/Guide） -->
                <ColumnDefinition Width="*"/>   <!-- 右エリア（ABXY + RT/RB） -->
            </Grid.ColumnDefinitions>

            <!-- ===== 左エリア ===== -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- LT / LB -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Button x:Name="BtnLT" Content="LT" Style="{StaticResource SmallBtn}"
                            Background="#5a5a8a" Margin="4,0"
                            PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="LT"/>
                    <Button x:Name="BtnLB" Content="LB" Style="{StaticResource SmallBtn}"
                            Background="#5a5a8a" Margin="4,0"
                            PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="LB"/>
                </StackPanel>

                <!-- 十字キー -->
                <Grid Width="160" Height="160" HorizontalAlignment="Center">
                    <!-- Up -->
                    <Button x:Name="BtnDUp" Content="▲" Style="{StaticResource DpadBtn}"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="DUp"/>
                    <!-- Down -->
                    <Button x:Name="BtnDDown" Content="▼" Style="{StaticResource DpadBtn}"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="DDown"/>
                    <!-- Left -->
                    <Button x:Name="BtnDLeft" Content="◀" Style="{StaticResource DpadBtn}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="DLeft"/>
                    <!-- Right -->
                    <Button x:Name="BtnDRight" Content="▶" Style="{StaticResource DpadBtn}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="DRight"/>
                    <!-- Center dummy -->
                    <Rectangle Width="52" Height="52" Fill="#2a2a4a"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- LS (左スティック押し込み) -->
                <Button x:Name="BtnLS" Content="LS" Style="{StaticResource SmallBtn}"
                        Background="#3a3a6a" HorizontalAlignment="Center" Margin="0,16,0,0"
                        PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="LS"/>
            </StackPanel>

            <!-- ===== 中央エリア ===== -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="20,0">
                <Button x:Name="BtnBack" Content="Back" Style="{StaticResource SmallBtn}"
                        Background="#4a4a6a" Width="60" Margin="0,0,0,12"
                        PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="Back"/>

                <!-- Xbox/Guide ボタン -->
                <Button x:Name="BtnGuide" Content="⏺" Style="{StaticResource CtrlBtn}"
                        Background="#1a6a1a" Width="50" Height="50" FontSize="20"
                        HorizontalAlignment="Center" Margin="0,0,0,12"
                        PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="Guide"/>

                <Button x:Name="BtnStart" Content="Start" Style="{StaticResource SmallBtn}"
                        Background="#4a4a6a" Width="60"
                        PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="Start"/>
            </StackPanel>

            <!-- ===== 右エリア ===== -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- RB / RT -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Button x:Name="BtnRB" Content="RB" Style="{StaticResource SmallBtn}"
                            Background="#5a5a8a" Margin="4,0"
                            PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="RB"/>
                    <Button x:Name="BtnRT" Content="RT" Style="{StaticResource SmallBtn}"
                            Background="#5a5a8a" Margin="4,0"
                            PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="RT"/>
                </StackPanel>

                <!-- ABXY ボタン -->
                <Grid Width="200" Height="200" HorizontalAlignment="Center">
                    <!-- Y (上・黄) -->
                    <Button x:Name="BtnY" Content="Y" Style="{StaticResource CtrlBtn}"
                            Background="#b8860b"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="Y"/>
                    <!-- A (下・緑) -->
                    <Button x:Name="BtnA" Content="A" Style="{StaticResource CtrlBtn}"
                            Background="#1a7a1a"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="A"/>
                    <!-- X (左・青) -->
                    <Button x:Name="BtnX" Content="X" Style="{StaticResource CtrlBtn}"
                            Background="#1a3a9a"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="X"/>
                    <!-- B (右・赤) -->
                    <Button x:Name="BtnB" Content="B" Style="{StaticResource CtrlBtn}"
                            Background="#9a1a1a"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="B"/>
                </Grid>

                <!-- RS (右スティック押し込み) -->
                <Button x:Name="BtnRS" Content="RS" Style="{StaticResource SmallBtn}"
                        Background="#3a3a6a" HorizontalAlignment="Center" Margin="0,16,0,0"
                        PreviewMouseDown="Button_Down" PreviewMouseUp="Button_Up" Tag="RS"/>
            </StackPanel>
        </Grid>

        <!-- アナログスティック（トラックパッド）：ドラッグで X/Y 軸入力 -->
        <StackPanel x:Name="StickArea" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <StackPanel Margin="24,0">
                <TextBlock Text="Left Stick (LX/LY)" Foreground="#888" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <Border x:Name="PadL" Width="120" Height="120" Background="#22223a"
                        CornerRadius="60" Tag="L"
                        PreviewMouseDown="Pad_Down" PreviewMouseMove="Pad_Move" PreviewMouseUp="Pad_Up">
                    <Canvas ClipToBounds="True">
                        <Ellipse x:Name="KnobL" Width="34" Height="34" Fill="#00d4ff"
                                 Canvas.Left="43" Canvas.Top="43"/>
                    </Canvas>
                </Border>
            </StackPanel>
            <StackPanel Margin="24,0">
                <TextBlock Text="Right Stick (RX/RY)" Foreground="#888" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <Border x:Name="PadR" Width="120" Height="120" Background="#22223a"
                        CornerRadius="60" Tag="R"
                        PreviewMouseDown="Pad_Down" PreviewMouseMove="Pad_Move" PreviewMouseUp="Pad_Up">
                    <Canvas ClipToBounds="True">
                        <Ellipse x:Name="KnobR" Width="34" Height="34" Fill="#00d4ff"
                                 Canvas.Left="43" Canvas.Top="43"/>
                    </Canvas>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- フッター（パッド選択 / プリセット / 状態表示。ui="controller" のときだけ出す） -->
        <Border x:Name="FooterArea" Grid.Row="3" Background="#0d0d1f" CornerRadius="8"
                Padding="12,8" Margin="0,16,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="物理パッド: " Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PadCombo" Width="190" FontSize="12"
                              SelectionChanged="PadCombo_Changed" VerticalAlignment="Center"/>
                    <Button Content="再スキャン" Click="Rescan_Click" Margin="8,0,0,0" Padding="8,2"
                            FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="   改変: " Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PresetCombo" Width="200" FontSize="12"
                              SelectionChanged="PresetCombo_Changed" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LoopText" Text="ループ -- Hz" Foreground="#00d4ff"
                               FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="押下中: " Foreground="#888" FontSize="12"/>
                    <TextBlock x:Name="PressedText" Text="なし" Foreground="#00d4ff" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 状態パネル（ui="status" と ui="fighting" のとき）。見るだけで、操作するものは置かない -->
        <Border x:Name="StatusArea" Grid.Row="4" Background="#0d0d1f" CornerRadius="8"
                Padding="14,12" Margin="0,0,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="StatusLine1" Foreground="#e6e8ee" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock x:Name="StatusLine2" Foreground="#9aa0b0" FontSize="12" Margin="0,0,0,4"/>
                <TextBlock x:Name="StatusLine3" Foreground="#9aa0b0" FontSize="12" Margin="0,0,0,4"/>
                <TextBlock x:Name="StatusLine4" Foreground="#9aa0b0" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- マイクのつまみとメーター（ui="fighting" のとき）。細かく詰めたいときだけ開く -->
        <Border x:Name="MicArea" Grid.Row="5" Background="#0d0d1f" CornerRadius="8"
                Padding="14,12" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="マイク" Foreground="#00d4ff" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="いまのレベル" Foreground="#888" FontSize="12"
                               Width="110" VerticalAlignment="Center"/>
                    <Border Width="300" Height="16" Background="#22223a" CornerRadius="3">
                        <Canvas ClipToBounds="True">
                            <Rectangle x:Name="MicLevelBar" Height="16" Width="0" Fill="#00d4ff"/>
                            <Rectangle x:Name="MicThresholdMark" Height="16" Width="2" Fill="#ff6b6b" Canvas.Left="60"/>
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="MicLevelText" Foreground="#00d4ff" FontSize="12"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="反応する大きさ" Foreground="#888" FontSize="12"
                               Width="110" VerticalAlignment="Center"/>
                    <Slider x:Name="MicThresholdSlider" Width="300" Minimum="0.01" Maximum="1.0"
                            SmallChange="0.01" LargeChange="0.05" VerticalAlignment="Center"
                            ValueChanged="MicThreshold_Changed"/>
                    <TextBlock x:Name="MicThresholdText" Foreground="#00d4ff" FontSize="12"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MicStateText" Foreground="#9aa0b0" FontSize="12" VerticalAlignment="Center"/>
                    <Button Content="マイクを調整する" Click="Calibrate_Click" Margin="16,0,0,0" Padding="10,3" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
